# Copy to .env.local (and add the same variables in Vercel → Settings → Environment Variables).
# Values: Firebase console → Project settings → General → Your apps → Web app → SDK config.
# Leave them empty to run the app local-only, without Google sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
