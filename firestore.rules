rules_version = '2';

// Each Google account reads and writes only its own data: users/{uid}/{collection}/{id}.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{collectionName}/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionName in ['plans', 'customPoses', 'sequences', 'poseNotes', 'poseEdits', 'images'];
    }
  }
}
